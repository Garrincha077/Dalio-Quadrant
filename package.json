{
  "name": "dalio-quadrant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "test": "node --test",
    "snapshot": "node scripts/snapshot.mjs",
    "research:v2:sources": "node scripts/research/v2/run.mjs sources",
    "research:v2": "node scripts/research/v2/run.mjs build",
    "research:v2:verify": "node scripts/research/v2/verify.mjs",
    "test:research:v2": "python scripts/research/v2/test_research.py",
    "research:v3:sources": "python scripts/research/v3/acquire.py",
    "research:v3": "node scripts/research/v3/run.mjs",
    "research:v3:verify": "node scripts/research/v3/verify.mjs",
    "test:research:v3": "python scripts/research/v3/test_research.py",
    "research:v4": "node scripts/research/v4/run.mjs",
    "research:v4:verify": "node scripts/research/v4/verify.mjs",
    "test:research:v4": "python -m unittest discover -s scripts/research/v4 -p 'test_*.py'"
  },
  "engines": {
    "node": ">=22"
  }
}
